<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Authors>Raypro</Authors>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-serialnumber-generator</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-serialnumber-generator.git</RepositoryUrl>
    <PackageTags>Tgs SN SerialNumber</PackageTags>
    <SqlQueryToolsConnectionString />
    <PackageId>Tgs.SerialNumberGenerator</PackageId>
    <RootNamespace>Tgs.SerialNumberGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="6.0.0" />
    <PackageReference Include="System.Data.HashFunction.MurmurHash" Version="2.0.0" />
  </ItemGroup>

</Project>
